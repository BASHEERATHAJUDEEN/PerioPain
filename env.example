# PerioPain AI — Environment Variables
# Copy this to .env and fill in your values

# Claude AI API Key (required for live AI chat & reasoning)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# JWT Secret (change this in production!)
SECRET_KEY=periopain-dev-secret-change-in-prod

# Optional: set to a custom path for the SQLite database
# DB_PATH=./periopain.db
